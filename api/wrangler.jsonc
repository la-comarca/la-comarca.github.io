{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-comarca-formularios",
  "main": "worker-entry.mjs",
  "account_id": "0b4dd54f3b1974a7036afdf876164aa2",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{"pattern":"comarca.kipadmon.com","custom_domain":true}],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/auth","/auth/*","/backoffice/api/*","/backoffice/v2/*","/backoffice/ops/*","/backoffice/hub/*","/backoffice/documents/*","/backoffice/setup","/backoffice/setup/*","/cms","/cms/*","/equipo/activar","/public/*","/calendario.ics","/solicitudes"]
  },
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1},"traces":{"enabled":true,"head_sampling_rate":0.1}},
  "vars": {
    "CMS_ORIGIN": "https://comarca.kipadmon.com",
    "SUPABASE_URL": "https://towouvaslpawbdzvksjo.supabase.co",
    "SUPABASE_PROFILE_SYNC_ENABLED": "true",
    "TEAM_INVITE_REDIRECT": "https://la-comarca.github.io/equipo/",
    "ALLOWED_ORIGINS": "https://comarca.kipadmon.com,https://la-comarca.github.io,https://jadrk040507.github.io,https://la-comarca-formularios.la-comarca.workers.dev",
    "PUBLIC_AGENDA_SOURCE": "notion",
    "CMS_CONNECTED_MODULES": "materials,transport,students,attendance,lessons,grades,topics,shifts,registrations",
    "NOTION_AGENDA_ID": "3d479aad-5d83-80f6-bbdd-000b94a2fce1",
    "NOTION_DATA_SOURCE_ID": "3d479aad-5d83-8055-a2d6-000b045a7d89",
    "CMS_AGENDA_EDIT_ENABLED": "true"
  },
  "d1_databases": [{"binding":"CMS_DB","database_name":"la-comarca-cms","database_id":"eda9a03b-1ff4-479c-b45a-5a3e5bc52aa8","migrations_dir":"migrations"}],
  "ratelimits": [{"name":"FORM_LIMIT","namespace_id":"1047","simple":{"limit":8,"period":60}}]
}
